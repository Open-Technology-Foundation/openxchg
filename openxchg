#!/usr/bin/env bash
# openxchg - Multi-currency exchange rate database manager
#
# Fetches exchange rates from openexchangerates.org and stores them in a
# SQLite database, one table per base currency. Currency codes are
# case-insensitive; options can appear anywhere on the command line.
#
# Modes:
#   UPDATE - no currency codes given: fetch all rates for a date and store
#   QUERY  - currency codes given: display stored rates
#   LATEST - with -l: fetch and display current rates (not stored)
set -euo pipefail
shopt -s inherit_errexit

declare -r VERSION='2.0.0'
#shellcheck disable=SC2155
declare -r SCRIPT_PATH=$(realpath -e -- "$0")
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

declare -- DB_PATH=${DB_PATH:-/var/lib/openxchg/xchg.db}
declare -r HISTORICAL_URL='https://openexchangerates.org/api/historical/'
declare -r LATEST_URL='https://openexchangerates.org/api/latest.json'
declare -- OPENEXCHANGE_API_KEY=${OPENEXCHANGE_API_KEY:-'2a9989da6985438481f9a5f3801d84d1'}

# Supported currencies (openexchangerates.org)
declare -ra MU=( AED AFN ALL AMD ANG AOA ARS AUD AWG AZN BAM BBD BDT BGN BHD BIF BMD BND BOB BRL BSD BTC BTN BWP BYN BZD CAD CDF CHF CLF CLP CNH CNY COP CRC CUC CUP CVE CZK DJF DKK DOP DZD EGP ERN ETB EUR FJD FKP GBP GEL GGP GHS GIP GMD GNF GTQ GYD HKD HNL HRK HTG HUF IDR ILS IMP INR IQD IRR ISK JEP JMD JOD JPY KES KGS KHR KMF KPW KRW KWD KYD KZT LAK LBP LKR LRD LSL LYD MAD MDL MGA MKD MMK MNT MOP MRU MUR MVR MWK MXN MYR MZN NAD NGN NIO NOK NPR NZD OMR PAB PEN PGK PHP PKR PLN PYG QAR RON RSD RUB RWF SAR SBD SCR SDG SEK SGD SHP SLL SOS SRD SSP STD STN SVC SYP SZL THB TJS TMT TND TOP TRY TTD TWD TZS UAH UGX USD UYU UZS VND VUV WST XAF XAG XAU XCD XDR XOF XPD XPF XPT YER ZAR ZMW ZWL )

# Cross rates for one fetch: XRATES[CODE] = base_rate / code_rate
declare -A XRATES=()

declare -i VERBOSE=1 LATEST_MODE=0
declare -- TMPFILE=''

if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' YELLOW=$'\033[0;33m' NC=$'\033[0m'
else
  declare -r RED='' YELLOW='' NC=''
fi

# Messaging
#shellcheck disable=SC2059
_msg() { >&2 printf "$SCRIPT_NAME: $1 %s\n" "${@:2}"; }
error() { _msg "$RED✗$NC" "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }
warn() { _msg "$YELLOW▲$NC" "$@"; }
info() { ((VERBOSE)) || return 0; _msg '◉' "$@"; }

noarg() { (($# > 1)) || die 22 "Option ${1@Q} requires an argument"; }

cleanup() {
  local -i exitcode=${1:-$?}
  trap - SIGINT SIGTERM EXIT
  [[ -z $TMPFILE ]] || rm -f -- "$TMPFILE"
  exit "$exitcode"
}
trap 'cleanup $?' SIGINT SIGTERM EXIT

usage() {
  cat <<USAGE
$SCRIPT_NAME $VERSION - Multi-currency exchange rate database manager

Fetches exchange rates from openexchangerates.org and stores them in SQLite,
one table per base currency. ${#MU[@]} currencies supported. Currency codes are
case-insensitive; options can appear anywhere on the command line.

Usage: $SCRIPT_NAME [OPTIONS] [base_currency] [CurrencyCode ...]

Options:
  -d, --date DATE     Date for query/update (default: yesterday UTC)
  -a, --apikey KEY    API key (overrides OPENEXCHANGE_API_KEY env)
  -l, --latest        Fetch current real-time rates (display only, not stored)
  -q, --quiet         Suppress informational output
  -v, --verbose       Verbose output (default)
  -V, --version       Show version
  -h, --help          Show this help

Modes:
  UPDATE: no currency codes - fetch all rates for the date and store them
  QUERY:  currency codes given - display stored rates from the database
  LATEST: with -l - fetch and display current rates (not stored)

Examples:
  $SCRIPT_NAME idr usd eur gbp        # query stored rates (IDR table)
  $SCRIPT_NAME -d 2025-01-01 eur usd  # query specific date
  $SCRIPT_NAME idr                    # update IDR table for yesterday
  $SCRIPT_NAME -d 2025-01-01 usd      # update USD table for a date
  $SCRIPT_NAME -l idr usd eur         # current real-time rates
  $SCRIPT_NAME -q idr                 # quiet update (for cron)

Environment:
  OPENEXCHANGE_API_KEY   API key (get one free: openexchangerates.org/signup)
  DB_PATH                Database file (default: /var/lib/openxchg/xchg.db)

Database:
  Tables:  one per base currency (IDR, USD, EUR, ...)
  Columns: id, Date, Currency, Unit, Xchg, Updated
  Dates are UTC (End-of-Day rates for completed UTC days).
  Maintenance via sqlite3 directly: .schema, VACUUM, PRAGMA integrity_check.
USAGE
}

# Map common aliases to ISO codes; uppercase everything else
normalize_currency() {
  local -- c=${1^^}
  case $c in
    RMB|RENMINBI|YUAN) c=CNY ;;
    RUPIAH)            c=IDR ;;
    YEN)               c=JPY ;;
    STERLING|POUND)    c=GBP ;;
    DOLLAR|GREENBACK)  c=USD ;;
    FRANC|SWISSY)      c=CHF ;;
    AUSSIE)            c=AUD ;;
    KIWI)              c=NZD ;;
    LOONIE)            c=CAD ;;
  esac
  echo "$c"
}

validate_currency() {
  local -- c=$1
  [[ $c =~ ^[A-Z]{3}$ ]] || die 22 "Invalid currency code ${c@Q} (must be a 3-letter code)"
  [[ " ${MU[*]} " == *" $c "* ]] || die 22 "Currency ${c@Q} not supported by API"
}

ensure_table() {
  local -- t=$1
  sqlite3 "$DB_PATH" <<SQL || die 1 "Cannot initialise table ${t@Q} in ${DB_PATH@Q}"
CREATE TABLE IF NOT EXISTS $t (
  id INTEGER PRIMARY KEY,
  Date DATE NOT NULL,
  Currency TEXT NOT NULL DEFAULT 'USD',
  Unit INTEGER NOT NULL DEFAULT 1,
  Xchg REAL NOT NULL DEFAULT 0.0,
  Updated TIMESTAMP NOT NULL,
  UNIQUE(Date, Currency)
);
CREATE INDEX IF NOT EXISTS idx_${t}_currency ON $t(Currency);
CREATE INDEX IF NOT EXISTS idx_${t}_updated ON $t(Updated);
SQL
}

# Fetch API JSON and populate XRATES with cross rates for $base.
# jq does the base_rate/currency_rate division; only strictly-numeric
# values survive the read loop, so XRATES is safe to embed in SQL.
fetch_rates() {
  local -- base=$1 url=$2
  wget -qO "$TMPFILE" "$url" || die 1 'Failed to fetch rates from API'
  jq empty "$TMPFILE" 2>/dev/null || die 1 'Invalid JSON received from API'

  local -- api_err
  api_err=$(jq -r 'if .error == true then (.description // .message // "unknown") else empty end' "$TMPFILE")
  [[ -z $api_err ]] || die 1 "API error: $api_err"

  local -- key value
  while IFS=$'\t' read -r key value; do
    [[ $key =~ ^[A-Z]{3}$ ]] || continue
    [[ $value =~ ^[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?$ ]] || continue
    XRATES[$key]=$value
  done < <(jq -r --arg base "$base" '
    (.rates // {}) as $r
    | $r[$base] as $b
    | if $b == null or $b == 0 then empty
      else $r | to_entries[]
           | select((.value | type) == "number" and .value != 0)
           | "\(.key)\t\($b / .value)"
      end' "$TMPFILE")

  ((${#XRATES[@]})) || die 1 "Base currency ${base@Q} not found in API response"
}

query_rates() {
  local -- base=$1 dte=$2
  shift 2

  local -i exists
  exists=$(sqlite3 "$DB_PATH" \
    "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='$base'")
  ((exists)) || die 3 "No ${base@Q} table in database (run '$SCRIPT_NAME ${base,,}' to populate)"

  if ((VERBOSE)); then
    printf '%-10s  %-14s  %s\n' 'Currency' 'Xchg' 'Date (UTC)'
    printf '%-10s  %-14s  %s\n' '----------' '--------------' '----------'
  fi

  local -- code
  for code in "$@"; do
    while IFS='|' read -r c x d; do
      printf '%-10s  %-14s  %s\n' "$c" "$x" "$d"
    done < <(sqlite3 -separator '|' "$DB_PATH" \
      "SELECT Currency, rtrim(rtrim(printf('%.6f', Xchg), '0'), '.'), Date
       FROM $base WHERE Date <= '$dte' AND Currency = '$code'
       ORDER BY Date DESC LIMIT 1")
  done
}

show_latest() {
  local -- base=$1
  shift
  fetch_rates "$base" "$LATEST_URL?app_id=$OPENEXCHANGE_API_KEY"

  local -- ts updated=''
  ts=$(jq -r '.timestamp // empty' "$TMPFILE")
  [[ $ts =~ ^[0-9]+$ ]] && updated=$(TZ=UTC date -d "@$ts" '+%F %T UTC') ||:
  info "Latest real-time rates (not stored), base $base${updated:+, updated $updated}"

  if ((VERBOSE)); then
    printf '%-10s  %s\n' 'Currency' 'Xchg'
    printf '%-10s  %s\n' '----------' '--------------'
  fi

  local -a codes=("$@")
  ((${#codes[@]})) || codes=("${MU[@]}")
  local -- code
  for code in "${codes[@]}"; do
    if [[ -n ${XRATES[$code]:-} ]]; then
      printf '%-10s  %s\n' "$code" "${XRATES[$code]}"
    else
      warn "Currency $code not in API response"
    fi
  done
}

update_db() {
  local -- base=$1 dte=$2

  local -- db_dir=${DB_PATH%/*}
  [[ -d $db_dir ]] || mkdir -p -- "$db_dir" \
    || die 13 "Cannot create ${db_dir@Q} (create it manually with suitable permissions)"

  ensure_table "$base"
  info "Base currency: $base" "Date: $dte"
  fetch_rates "$base" "$HISTORICAL_URL$dte.json?app_id=$OPENEXCHANGE_API_KEY"

  # Single multi-row INSERT; codes and values are regex-validated in fetch_rates
  local -- code values=''
  local -i count=0
  for code in "${MU[@]}"; do
    [[ -n ${XRATES[$code]:-} ]] || continue
    values+="('$dte','$code',1,${XRATES[$code]},CURRENT_TIMESTAMP),"
    count+=1
  done
  ((count)) || die 1 'No rates to insert'

  sqlite3 "$DB_PATH" \
    "INSERT OR REPLACE INTO $base (Date, Currency, Unit, Xchg, Updated) VALUES ${values%,}" \
    || die 1 'Database insert failed'
  info "Update complete: $count currencies stored for $dte ($base table)"
}

main() {
  local -- dte=''
  local -a args=()

  while (($#)); do case $1 in
    -d|--date)    noarg "$@"; shift
                  dte=$(TZ=UTC date +%F -d "$1" 2>/dev/null) || die 22 "Invalid date ${1@Q}" ;;
    -a|--apikey)  noarg "$@"; shift; OPENEXCHANGE_API_KEY=$1 ;;
    -l|--latest)  LATEST_MODE=1 ;;
    -q|--quiet)   VERBOSE=0 ;;
    -v|--verbose) VERBOSE=1 ;;
    -V|--version) echo "$SCRIPT_NAME $VERSION"; exit 0 ;;
    -h|--help)    usage; exit 0 ;;
    --)           shift; args+=("$@"); break ;;
    -[dalqvVh]?*) set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;
    -*)           die 22 "Invalid option ${1@Q}" ;;
    *)            args+=("$1") ;;
  esac; shift; done
  readonly VERBOSE LATEST_MODE

  if ((LATEST_MODE)) && [[ -n $dte ]]; then
    die 22 'Options --latest and --date are mutually exclusive'
  fi
  [[ -n $dte ]] || dte=$(TZ=UTC date +%F -d yesterday)

  local -i i
  for ((i=0; i<${#args[@]}; i+=1)); do
    args[i]=$(normalize_currency "${args[i]}")
    validate_currency "${args[i]}"
  done

  local -- base=IDR
  if ((${#args[@]})); then
    base=${args[0]}
    args=("${args[@]:1}")
  fi

  TMPFILE=$(mktemp) || die 1 'Failed to create temp file'

  if ((LATEST_MODE)); then
    show_latest "$base" "${args[@]}"
  elif ((${#args[@]})); then
    [[ -f $DB_PATH ]] || die 3 "Database not found ${DB_PATH@Q} (run '$SCRIPT_NAME ${base,,}' to create)"
    query_rates "$base" "$dte" "${args[@]}"
  else
    update_db "$base" "$dte"
  fi
}

main "$@"
#fin
