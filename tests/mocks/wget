#!/usr/bin/env bash
# wget - mock for openxchg tests
#
# Serves JSON fixtures from $MOCK_FIXTURES when MOCK_API_ENABLED=true;
# otherwise execs the real wget. MOCK_API_ERROR=1 forces the API-error
# fixture regardless of endpoint.
set -euo pipefail
shopt -s inherit_errexit

if [[ ${MOCK_API_ENABLED:-false} != true ]]; then
  exec /usr/bin/wget "$@"
fi

declare -- out='' url=''
while (($#)); do
  case $1 in
    -O|-qO) shift; out=$1 ;;
    -*)     ;;
    *)      url=$1 ;;
  esac
  shift
done

declare -- fixture=''
if ((${MOCK_API_ERROR:-0})); then
  fixture="$MOCK_FIXTURES/error.json"
elif [[ $url == */latest.json* ]]; then
  fixture="$MOCK_FIXTURES/latest.json"
elif [[ $url == */historical/* ]]; then
  fixture="$MOCK_FIXTURES/historical.json"
else
  >&2 echo "mock wget: unknown endpoint: $url"
  exit 1
fi

[[ -f $fixture ]] || { >&2 echo "mock wget: missing fixture ${fixture@Q}"; exit 1; }
[[ -n $out ]] || { >&2 echo 'mock wget: no -O output file given'; exit 1; }
cp -- "$fixture" "$out"
#fin
